#usda 1.0
(
    doc = "runnerSchema registration smoke fixture"
)

def Cube "Body" (
    prepend apiSchemas = ["RunnerPhysicsBodyAPI", "RunnerColliderAPI", "RunnerCharacterAPI"]
)
{
    uniform double runner:character:groundProbeDistance = 0.15
    uniform double runner:character:jumpSpeed = 6
    uniform double runner:character:maximumSlopeAngleRadians = 0.6
    uniform double3 runner:physics:halfExtents = (0.5, 0.5, 0.5)
    uniform double runner:physics:mass = 2
    uniform token runner:physics:motionType = "dynamic"
    uniform token runner:physics:shape = "box"
}

def Xform "CameraTarget"
{
}

def Camera "Camera" (
    prepend apiSchemas = ["RunnerCameraRigAPI"]
)
{
    rel runner:camera:anchor = </CameraTarget>
    uniform double runner:camera:damping = 8
    uniform double runner:camera:distance = 5
    uniform token runner:camera:mode = "thirdPerson"
    uniform double3 runner:camera:offset = (0, 1.5, 0)
    uniform double runner:camera:pitchRadians = -0.2
    rel runner:camera:target = </Body>
    uniform double runner:camera:yawRadians = 0.4
}
