#usda 1.0
(
    """
    Authored runtime declarations for usd-stage-runner. This is the source of
    truth for the codeless physics, collider, character, and camera API schemas.
    """
    subLayers = [
        @usd/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName      = "runnerSchema"
        string libraryPath      = "."
        string libraryPrefix    = ""
        string tokensPrefix     = "Runner"
        bool skipCodeGeneration = true
    }
)
{
}

class "RunnerPhysicsBodyAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
    }
    doc = "Declares a prim as a static or dynamic runtime physics body."
)
{
    uniform token runner:physics:motionType = "static" (
        allowedTokens = ["static", "dynamic"]
        doc = "Whether the body is static or dynamically simulated."
    )
    uniform double runner:physics:mass = 1 (
        doc = "Positive body mass in kilograms. Ignored for static bodies."
    )
}

class "RunnerColliderAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
    }
    doc = "Declares the collision shape used by a runtime physics body."
)
{
    uniform token runner:physics:shape = "box" (
        allowedTokens = ["box"]
        doc = "Collider shape. The initial contract supports boxes only."
    )
    uniform double3 runner:physics:halfExtents = (1, 1, 1) (
        doc = "Positive local-space box half extents, before xform scale ops."
    )
}

class "RunnerCharacterAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
    }
    doc = "Declares a dynamic physics body as a runtime character controller."
)
{
    uniform double runner:character:groundProbeDistance = 0.1 (
        doc = "Non-negative downward ground probe distance in Stage meters."
    )
    uniform double runner:character:maximumSlopeAngleRadians = 0.7853981633974483 (
        doc = "Maximum walkable slope angle in radians. Must be in the range [0, pi / 2)."
    )
    uniform double runner:character:jumpSpeed = 5 (
        doc = "Positive upward jump speed in Stage meters per second."
    )
}

class "RunnerCameraRigAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
    }
    doc = "Declares a UsdGeomCamera as a runtime camera rig."
)
{
    rel runner:camera:target (
        doc = "Optional target prim. Required by every mode except free."
    )
    rel runner:camera:anchor (
        doc = "Optional prim whose transform overrides the target as the rig origin."
    )
    uniform token runner:camera:mode = "free" (
        allowedTokens = ["free", "firstPerson", "thirdPerson", "orbit"]
        doc = "Camera rig behavior mode."
    )
    uniform double3 runner:camera:offset = (0, 0, 0) (
        doc = "World-space framing offset from the target or anchor."
    )
    uniform double runner:camera:distance = 4 (
        doc = "Non-negative follow or orbit distance in Stage units."
    )
    uniform double runner:camera:pitchRadians = 0 (
        doc = "Vertical viewing angle in radians, strictly between -pi / 2 and pi / 2."
    )
    uniform double runner:camera:yawRadians = 0 (
        doc = "Horizontal viewing angle in radians."
    )
    uniform double runner:camera:damping = 0 (
        doc = "Non-negative exponential smoothing response rate in inverse seconds."
    )
}
