#usda 1.0
(
    upAxis = "Y"
)

def Xform "World"
{
    double xformOp:rotateY = 90
    uniform token[] xformOpOrder = ["xformOp:rotateY"]

    def Xform "Target"
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}

def Camera "Camera" (
    prepend apiSchemas = ["RunnerCameraRigAPI"]
)
{
    uniform token runner:camera:mode = "firstPerson"
    rel runner:camera:target = </World/Target>
}
