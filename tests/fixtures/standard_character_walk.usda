#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Ground" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double3 xformOp:scale = (5, 0.5, 5)
        double3 xformOp:translate = (0, -0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "PlayerCube" (
        prepend apiSchemas = [
            "PhysicsRigidBodyAPI", "PhysicsMassAPI",
            "PhysicsCollisionAPI",
            "RunnerCharacterAPI"
        ]
    )
    {
        uniform double runner:character:groundProbeDistance = 0.1
        uniform double runner:character:jumpSpeed = 6
        uniform double runner:character:maximumSlopeAngleRadians = 0.6
        double size = 1
        float physics:mass = 70
        double3 xformOp:translate = (0, 0.55, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "Camera"
    {
        double3 xformOp:translate = (0, 3, 8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
