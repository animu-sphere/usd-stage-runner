#usda 1.0
(
    upAxis = "Y"
)

def Xform "Rotated"
{
    double xformOp:rotateY = 90
    uniform token[] xformOpOrder = ["xformOp:rotateY"]

    def Camera "Camera" (
        prepend apiSchemas = ["RunnerCameraRigAPI"]
    )
    {
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
