#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "PlayerCube"
    {
        double3 xformOp:translate = (2, 1, -3)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Xform "Head"
        {
            double3 xformOp:translate = (0, 1, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Camera "FollowCamera" (
        prepend apiSchemas = ["RunnerCameraRigAPI"]
    )
    {
        rel runner:camera:anchor = </World/PlayerCube/Head>
        uniform double runner:camera:damping = 8
        uniform double runner:camera:distance = 5
        uniform token runner:camera:mode = "thirdPerson"
        uniform double3 runner:camera:offset = (0, 1.5, 0)
        uniform double runner:camera:pitchRadians = -0.2
        rel runner:camera:target = </World/PlayerCube>
        uniform double runner:camera:yawRadians = 0.4
        double3 xformOp:translate = (0, 3, 8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
