#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "PlayerCube" (
        prepend apiSchemas = ["RunnerPhysicsBodyAPI"]
    )
    {
        uniform token runner:physics:motionType = "dynamic"
        double3 xformOp:translate = (0, 3, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
