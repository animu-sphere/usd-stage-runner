#usda 1.0
(
    upAxis = "Y"
)

def Camera "Camera" (
    prepend apiSchemas = ["RunnerCameraRigAPI"]
)
{
    uniform token runner:camera:mode = "thirdPerson"
    rel runner:camera:target = </Camera>
    double3 xformOp:translate = (0, 0, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
