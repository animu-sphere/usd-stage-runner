#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Ground" (
        prepend apiSchemas = ["RunnerPhysicsBodyAPI", "RunnerColliderAPI"]
    )
    {
        uniform double3 runner:physics:halfExtents = (1, 1, 1)
        uniform token runner:physics:motionType = "static"
        double3 xformOp:scale = (5, 0.5, 5)
        double3 xformOp:translate = (0, -0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "PlayerCube" (
        prepend apiSchemas = [
            "RunnerPhysicsBodyAPI",
            "RunnerColliderAPI",
            "RunnerCharacterAPI"
        ]
    )
    {
        uniform double runner:character:groundProbeDistance = 0.1
        uniform double runner:character:jumpSpeed = 6
        uniform double runner:character:maximumSlopeAngleRadians = 0.6
        uniform double3 runner:physics:halfExtents = (0.5, 0.5, 0.5)
        uniform double runner:physics:mass = 70
        uniform token runner:physics:motionType = "dynamic"
        double3 xformOp:translate = (0, 0.55, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "ThirdPersonCamera" (
        prepend apiSchemas = ["RunnerCameraRigAPI"]
    )
    {
        uniform bool runner:camera:collisionEnabled = false
        uniform double runner:camera:damping = 0
        uniform double runner:camera:distance = 4
        uniform token runner:camera:mode = "thirdPerson"
        uniform double3 runner:camera:offset = (0, 1.5, 0)
        uniform double runner:camera:pitchRadians = 0
        rel runner:camera:target = </World/PlayerCube>
        uniform double runner:camera:yawRadians = 0
        double3 xformOp:translate = (0, 2.05, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
