#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Ground" (
        prepend apiSchemas = ["RunnerPhysicsBodyAPI", "RunnerColliderAPI"]
    )
    {
        uniform double3 runner:physics:halfExtents = (1, 1, 1)
        uniform token runner:physics:motionType = "static"
        double3 xformOp:scale = (5, 0.5, 5)
        double3 xformOp:translate = (0, -0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "PlayerCube" (
        prepend apiSchemas = [
            "RunnerPhysicsBodyAPI",
            "RunnerColliderAPI",
            "RunnerCharacterAPI"
        ]
    )
    {
        uniform double runner:character:groundProbeDistance = 0.1
        uniform double runner:character:jumpSpeed = 6
        uniform double runner:character:maximumSlopeAngleRadians = 0.6
        uniform double3 runner:physics:halfExtents = (0.5, 0.5, 0.5)
        uniform double runner:physics:mass = 70
        uniform token runner:physics:motionType = "dynamic"
        double3 xformOp:translate = (0, 0.55, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "Camera"
    {
        double3 xformOp:translate = (0, 3, 8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
