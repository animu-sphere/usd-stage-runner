#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Cube "Ground"
    {
        double3 xformOp:scale = (5, 0.1, 5)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Cube "PlayerCube"
    {
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Camera "Camera"
    {
        double3 xformOp:translate = (0, 3, 8)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
