#usda 1.0

def Xform "World"
{
    def Cube "PlayerCube" (
        prepend apiSchemas = [
            "RunnerPhysicsBodyAPI",
            "RunnerColliderAPI",
            "RunnerCharacterAPI"
        ]
    )
    {
        uniform token runner:physics:motionType = "static"
        double3 xformOp:translate = (0, 1, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
}
