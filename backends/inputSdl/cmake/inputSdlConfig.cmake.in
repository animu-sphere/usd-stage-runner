@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(inputCore CONFIG)
if("@INPUT_SDL_BACKEND@" STREQUAL "SDL3")
  find_dependency(SDL3 CONFIG)
elseif("@INPUT_SDL_BACKEND@" STREQUAL "SDL2")
  find_dependency(SDL2 CONFIG)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/inputSdlTargets.cmake")
